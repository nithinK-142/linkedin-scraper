# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Logs
logs/*
!logs/.gitkeep
*.log

# Generated data / archives / media (personal LinkedIn content, not source)
data/*.json
!data/*.example.json
!data/.gitkeep
archive/*
!archive/.gitkeep

# Local, non-secret config overrides
config.json

# OS / editor cruft
.DS_Store
*.swp
